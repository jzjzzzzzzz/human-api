# Development defaults. Replace both secrets before any public deployment.
DATABASE_URL=postgresql+asyncpg://human_api:human_api@postgres:5432/human_api
HUMAN_API_KEY_PEPPER=replace-with-at-least-32-random-characters
SESSION_TOKEN_PEPPER=replace-with-a-different-32-character-secret
HUMAN_API_MODEL_ID=human-1
HUMAN_API_ENABLED=true
HUMAN_RESPONSE_TIMEOUT_SECONDS=180
HUMAN_API_CLAIM_LEASE_SECONDS=180
HUMAN_API_ACTIVE_RESPONDER_SECONDS=45
HUMAN_API_REQUIRE_ACTIVE_RESPONDER=true
HUMAN_API_RATE_LIMIT_PER_MINUTE=10
HUMAN_API_MAX_INPUT_CHARS=50000
HUMAN_API_MAX_ANSWER_CHARS=50000
HUMAN_API_MAX_MESSAGES=100
SESSION_COOKIE_SECURE=false
